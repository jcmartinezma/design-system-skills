{
  "$schema": "https://www.designtokens.org/tr/2025.10/format/",
  "shadow": {
    "$description": "Raw shadow dimensions. Color lives in the core alpha ramp, not here.",
    "$type": "dimension",
    "offset": {
      "0": {
        "$value": { "value": 0, "unit": "px" },
        "$description": "shadow-offset-0"
      },
      "100": {
        "$value": { "value": 2, "unit": "px" },
        "$description": "shadow-offset-100 — 2px"
      }
    },
    "blur": {
      "100": {
        "$value": { "value": 8, "unit": "px" },
        "$description": "shadow-blur-100 — 8px"
      }
    },
    "spread": {
      "0": {
        "$value": { "value": 0, "unit": "px" },
        "$description": "shadow-spread-0"
      }
    }
  }
}
